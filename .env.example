# 앱인토스 광고 식별자 — 실제 값은 앱인토스 콘솔 > 수익화 > 광고에서 발급받아
# .env.local 에 복사해 넣는다(.env.local 은 커밋하지 않는다).
# 값이 비어 있으면 광고 영역은 조용히 렌더되지 않고, 화면 나머지는 그대로 동작한다.

# 배너 광고 그룹 ID — AdSlot 의 adGroupId 로 전달
VITE_TOSS_AD_GROUP_ID=

# 전면/리워드 광고 슬롯 ID — loadFullScreenAd / showFullScreenAd 의 slotId 로 전달
VITE_TOSS_AD_SLOT_ID=
